APP_NAME="JobPulse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jobpulse.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# Any Laravel-supported driver works. SQLite is enough for this project —
# the whole dataset is a few thousand rows refreshed from a live API.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jobpulse
# DB_USERNAME=jobpulse
# DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database

# Remotive's public API needs no key. Kept here so the base URL/rate limit
# are configurable without touching code.
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
REMOTIVE_MAX_REQUESTS_PER_DAY=4

# Simple shared-secret used to protect the manual "refresh now" endpoint —
# not a full auth system, this project has no user accounts.
ADMIN_REFRESH_TOKEN=change-me
